# Copy to .env and edit. Every value here is optional.

# generator: "acestep" (a running ACE-Step 1.5 server) or "mock" (no model)
TAKEROOM_BACKEND=acestep
ACESTEP_URL=http://127.0.0.1:8001
# ACESTEP_API_KEY=sk-your-key        # only if you started ACE-Step with --api-key
ACESTEP_TIMEOUT=900

# lyric + prompt writer (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# mastering
TAKEROOM_TARGET_LUFS=-11.0
TAKEROOM_CEILING_DBFS=-1.0
TAKEROOM_EXPORT_MP3=true

# stems
TAKEROOM_DEMUCS_MODEL=htdemucs

# server
TAKEROOM_HOST=127.0.0.1
TAKEROOM_PORT=8800
TAKEROOM_DATA=./data
